# The Vue frontend: Vite builds it, nginx serves it and proxies /api (Socket.IO included) to the webhook container.
# VITE_* are baked into the bundle at build time, so they are build args (docker-compose.prod.yml passes them from .env).
FROM oven/bun:1.3.5 AS build
WORKDIR /app
COPY package.json bun.lock bunfig.toml ./
RUN bun install --frozen-lockfile --ignore-scripts
COPY tsconfig.json ./
# src/web imports types from src/server through the @server alias
COPY src ./src

ARG VITE_BASE_PATH=/
ARG VITE_API_HOST=/
ARG VITE_APP_NAME
ARG VITE_ENVIRONMENT=production
ARG VITE_DEBUG=false
ARG VITE_POSTHOG_KEY
ARG VITE_POSTHOG_HOST
ARG VITE_SENTRY_DSN
ARG VITE_SENTRY_ORG
ARG VITE_SENTRY_PROJECT
ARG VITE_SENTRY_AUTH_TOKEN
ENV VITE_BASE_PATH=$VITE_BASE_PATH VITE_API_HOST=$VITE_API_HOST VITE_APP_NAME=$VITE_APP_NAME \
    VITE_ENVIRONMENT=$VITE_ENVIRONMENT VITE_DEBUG=$VITE_DEBUG VITE_POSTHOG_KEY=$VITE_POSTHOG_KEY \
    VITE_POSTHOG_HOST=$VITE_POSTHOG_HOST VITE_SENTRY_DSN=$VITE_SENTRY_DSN VITE_SENTRY_ORG=$VITE_SENTRY_ORG \
    VITE_SENTRY_PROJECT=$VITE_SENTRY_PROJECT VITE_SENTRY_AUTH_TOKEN=$VITE_SENTRY_AUTH_TOKEN
RUN bun run web:build

FROM nginx:alpine
COPY --from=build /app/dist/web /usr/share/nginx/html
COPY nginx/default.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
