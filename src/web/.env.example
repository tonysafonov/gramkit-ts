# Dev server: copy to .env.local (or export). Read from the repo root's environment too.
# Mock-user login and the debug panel (needs the backend's DEBUG=true).
VITE_DEBUG=true
# Backend the dev server proxies /api to.
DEV_API_URL=http://localhost:8000
# Set only to call an API on another origin directly (then it needs CORS); empty uses the /api proxy.
VITE_API_HOST=
