# Copy to .env. Same variable names as the Python gramkit.
#
# Local development: the values below work with `make up` (Postgres on 5460, Redis on 6395).
# Production (docker-compose.prod.yml): set what the "PRODUCTION" notes say. The compose file overrides DB__HOST/PORT and
# REDIS__HOST/PORT with its own containers, so only the credentials matter there.
APP_NAME=template
# PRODUCTION: ENVIRONMENT=production, DEBUG=false
ENVIRONMENT=local
DEBUG=true
DEBUG_USERNAME=debug_user
LOG_LEVEL=info

# Server (runtime/serve.*)
HOST=0.0.0.0
PORT=8000
# API processes behind one port (one per CPU core is a good number). Socket.IO polling needs sticky sessions above 1.
WORKERS=1
KEEP_ALIVE_TIMEOUT=95

# Telegram (from @BotFather). Leave empty for a web-only app.
BOT__TOKEN=
BOT__URL=https://t.me/your_bot_username
# Empty: the bot process long-polls. Set: it registers this webhook and serves it on BOT__WEBHOOK_PORT, at the URL's path,
# and BOT__WEBHOOK_SECRET is required (1-256 of A-Z a-z 0-9 _ -, e.g. `openssl rand -hex 32`).
BOT__WEBHOOK_URL=
BOT__WEBHOOK_PORT=8081
BOT__WEBHOOK_SECRET=
# Seconds a Mini App's initData logs in from its auth_date (0: forever). A Mini App left open longer must be reopened.
BOT__INIT_DATA_MAX_AGE=86400

# RBAC: Telegram ids that are always owners
RBAC__OWNER_IDS=[]

# Web
# PRODUCTION: the public URLs, e.g. WEB__FRONTEND_URL=https://app.example.com, WEB__API_URL=https://app.example.com/api
WEB__APP_URL=https://t.me/your_bot_username/app
WEB__FRONTEND_URL=http://localhost:5174
WEB__API_URL=http://localhost:8000
WEB__API_ROOT_PATH=
# JSON list of origins allowed to call the API with cookies (not needed when the frontend proxies /api, as the nginx
# in this repo does)
WEB__CORS_ORIGINS=[]
WEB__SHUTDOWN_DRAIN_TIMEOUT=30

# Database (docker-compose.yml: host port 5460)
# PRODUCTION: set a real DB__PASSWORD (the postgres container is created with it)
DB__HOST=localhost
DB__PORT=5460
DB__USER=postgres
DB__PASSWORD=postgres
DB__NAME=gramkit
DB__POOL_SIZE=10

# Redis (docker-compose.yml: host port 6395)
REDIS__HOST=localhost
REDIS__PORT=6395
REDIS__PASSWORD=

# Rate limiter
RATE_LIMIT__ENABLED=true

# RabbitMQ (optional)
RABBIT__URL=amqp://guest:guest@localhost:5672/
RABBIT__QUEUE_NAME=bot_queue

# Sessions
SESSION__EXPIRE_DAYS=7
# PRODUCTION: SESSION__COOKIE_SECURE=true (the default when unset; needs HTTPS in front)
SESSION__COOKIE_SECURE=false
SESSION__COOKIE_HTTPONLY=true
SESSION__COOKIE_SAMESITE=lax
# SESSION__COOKIE_DOMAIN=example.com

# Payments (YooKassa)
PAYMENT__SHOP_ID=
PAYMENT__SECRET_KEY=
PAYMENT__RECEIPT_EMAIL=

# Email (Resend)
EMAIL__API_KEY=
EMAIL__FROM_ADDRESS=
EMAIL__FROM_NAME=

# OpenAI-compatible endpoint (optional)
OPENAI__API_KEY=
OPENAI__BASE_URL=https://api.openai.com/v1

# Observability (optional)
OBSERVABILITY__SENTRY_DSN=
OBSERVABILITY__SENTRY_TRACES_SAMPLE_RATE=0.05
OBSERVABILITY__SENTRY_PROFILES_SAMPLE_RATE=0
OBSERVABILITY__POSTHOG_API_KEY=
OBSERVABILITY__POSTHOG_HOST=https://app.posthog.com
# Tags Sentry events and admin messages. (Logfire is not ported: OBSERVABILITY__LOGFIRE_TOKEN is not read.)
OBSERVABILITY__LOGFIRE_ENVIRONMENT=development

# ---------------------------------------------------------------------------------------------------------------------
# Docker only (docker-compose.prod.yml). The server ignores these.
# ---------------------------------------------------------------------------------------------------------------------
# node: Node 24 runs the esbuild bundles. bun: Bun runs the TypeScript source. Needs a rebuild to change.
RUNTIME=node
# The host port of the frontend container (nginx); put TLS in front of it
FRONTEND_PORT=8080
# Compose's own env file for the containers (default .env)
# ENV_FILE=.env

# The frontend build (Vite bakes VITE_* into the bundle: rebuild with `docker compose -f docker-compose.prod.yml build
# frontend` after a change). The same names work in .env for `bun run web:dev`.
# "/" means: call the API at /api on the page's own origin (nginx proxies it to the webhook).
VITE_API_HOST=/
VITE_BASE_PATH=/
VITE_APP_NAME=
VITE_ENVIRONMENT=production
VITE_DEBUG=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
VITE_SENTRY_ORG=
VITE_SENTRY_PROJECT=
VITE_SENTRY_AUTH_TOKEN=
