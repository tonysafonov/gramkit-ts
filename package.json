{
  "name": "gramkit-ts",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24",
    "bun": ">=1.3"
  },
  "//": "Production: Node runs the bundles (`bun run build`, then `start:node`, `start:bot:node`, `start:worker:node`); Bun runs the TypeScript source (`start:bun`, `start:bot`, `start:worker`).",
  "scripts": {
    "dev": "GRAMKIT_WORKER=1 bun --watch src/server/runtime/main.bun.ts",
    "dev:bot": "bun --watch src/server/bot/main.ts",
    "dev:worker": "bun --watch src/server/worker/main.ts",
    "build": "bun scripts/build.ts",
    "start:node": "node dist/main.node.js",
    "start:bun": "bun src/server/runtime/main.bun.ts",
    "start:bot": "bun src/server/bot/main.ts",
    "start:bot:node": "node dist/bot.node.js",
    "start:worker": "bun src/server/worker/main.ts",
    "start:worker:node": "node dist/worker.node.js",
    "script": "bun src/server/scripts/main.ts",
    "typecheck": "node node_modules/typescript-native/bin/tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun src/server/db/migrate.ts",
    "route-parity": "bun scripts/route-parity.ts",
    "smoke": "bun scripts/smoke.ts",
    "web:dev": "vite --config src/web/vite.config.ts",
    "web:build": "vue-tsc --noEmit -p src/web/tsconfig.json && vite build --config src/web/vite.config.ts",
    "web:typecheck": "vue-tsc --noEmit -p src/web/tsconfig.json",
    "web:lint": "eslint --config src/web/eslint.config.js src/web"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@sentry/node": "^11.11.0",
    "@socket.io/bun-engine": "^0.1.2",
    "amqplib": "^2.2.1",
    "bcrypt": "^6.0.0",
    "bullmq": "^6.7.2",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "grammy": "^1.46.0",
    "hono": "^4.13.17",
    "ioredis": "^6.0.0",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "posthog-node": "^5.63.1",
    "socket.io": "^4.8.4",
    "uuid": "^14.0.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.6",
    "@lucide/vue": "^1.48.0",
    "@sentry/vite-plugin": "^2.23.1",
    "@sentry/vue": "^8.55.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/vue-query": "^5.104.0",
    "@twa-dev/sdk": "8.0.2",
    "@types/amqplib": "^0.10.8",
    "@types/bcrypt": "^6.0.0",
    "@types/bun": "^1.4.4",
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vueuse/core": "^15.0.0",
    "axios": "^1.20.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-unused-imports": "^4.4.1",
    "eslint-plugin-vue": "^10.11.1",
    "normalize.css": "^8.0.1",
    "openapi-fetch": "^0.13.8",
    "pinia": "^4.0.3",
    "pino-pretty": "^13.2.0",
    "posthog-js": "^1.434.15",
    "reka-ui": "^2.10.5",
    "socket.io-client": "^4.8.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-motion": "^1.1.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.1",
    "typescript-native": "npm:typescript@^7.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0",
    "vue": "^3.5.43",
    "vue-i18n": "^11.4.12",
    "vue-router": "5.3.1",
    "vue-sonner": "^2.0.9",
    "vue-tsc": "^2.2.12",
    "vue3-lottie": "^3.3.1"
  }
}
